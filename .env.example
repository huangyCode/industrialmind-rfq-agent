# ---------- LLM provider ----------
# ollama (default, local) | openai_compat | anthropic
LLM_PROVIDER=ollama
# Text model; empty = provider default (ollama: gemma4:12b). Required for openai_compat / anthropic.
LLM_MODEL=
# Vision model for drawings; empty = same as LLM_MODEL
LLM_VISION_MODEL=
# live | record | replay | auto
#   auto   = cache hit -> use it; miss -> call the model if reachable and record; otherwise a clear error
#   replay = cache only (demo without a model); record = always call and overwrite; live = call, never write
LLM_MODE=auto
# Override the record/replay directory (default fixtures/llm_cache). Use a temp dir for experiments.
LLM_CACHE_DIR=
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_S=600

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=16384
# Keep only one local model in memory (set on the Ollama server side):
# OLLAMA_MAX_LOADED_MODELS=1

# ---------- OpenAI-compatible endpoint ----------
OPENAI_BASE_URL=
OPENAI_API_KEY=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
# Model id, if LLM_MODEL is not set
ANTHROPIC_MODEL=
